VITE_USE_MOCK=true

VITE_CLIENT_ID=

VITE_BASE_URL=https://midoffice-uat-api.icicilife.com
VITE_AUTH_SERVICE=/icic-iam-user-service
VITE_AUTH_LOGIN_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/login
VITE_AUTH_FORGOT_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/reset-password
VITE_AUTH_CHANGE_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/change-password
VITE_AUTH_LOGOUT_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/logout
VITE_AUTH_BASIC_USERNAME=
VITE_AUTH_BASIC_PASSWORD=

VITE_LANDING_SERVICE=/icic-drs-landing-service
VITE_RETAIL_ROLE_LIST_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/role-list
VITE_GROUP_ROLE_LIST_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/role-list
VITE_RETAIL_POOL_COLUMNS_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns
VITE_RETAIL_POOL_COLUMNS_SAVE_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns/save
VITE_GROUP_POOL_COLUMNS_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns
VITE_GROUP_POOL_COLUMNS_SAVE_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns/save

VITE_GROUP_API_URL=${VITE_BASE_URL}
