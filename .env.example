# One switch for Common, Retail, and Group. true reads each app's mock JSON.
# false sends that app to its own real API URL.
VITE_USE_MOCK=false

# Login gateway switch. true uses the Apigee login URL, Authorization Basic
# (VITE_APIGEE_BASIC_*), and encrypts the login body. false uses the mid-office
# login URL, X-Apigee-Authorization (VITE_AUTH_BASIC_*), and a plain JSON body.
# Other APIs are unchanged until they opt in. VITE_CLIENT_ID is required when true.
VITE_USE_APIGEE=false

# Used by login encryption when VITE_USE_APIGEE=true. At least 32 characters.
VITE_CLIENT_ID=

# Vite expands ${...} when the app starts. Change the host, service, or an API here only.
# Forgot, reset, change password, and logout stay on the mid-office header.
# Logout also sends Authorization: Bearer. Business APIs send Bearer only.
VITE_BASE_URL=https://midoffice-uat-api.icicilife.com
VITE_AUTH_SERVICE=/icic-iam-user-service
VITE_AUTH_LOGIN_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/login
VITE_AUTH_FORGOT_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/reset-password
VITE_AUTH_CHANGE_PASSWORD_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/change-password
VITE_AUTH_LOGOUT_API=${VITE_BASE_URL}${VITE_AUTH_SERVICE}/v1/auth/logout
VITE_APIGEE_BASE_URL=https://apignonprod.icicilife.com
VITE_APIGEE_AUTH_LOGIN_API=${VITE_APIGEE_BASE_URL}/v1/oauth/midoffice/auth/login
VITE_AUTH_BASIC_USERNAME=
VITE_AUTH_BASIC_PASSWORD=
VITE_APIGEE_BASIC_USERNAME=
VITE_APIGEE_BASIC_PASSWORD=

# Landing / inbox (role-list, pool columns). Same pattern as auth — compose URLs from .env only.
VITE_LANDING_SERVICE=/icic-drs-landing-service
VITE_RETAIL_ROLE_LIST_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/role-list
VITE_GROUP_ROLE_LIST_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/role-list
VITE_RETAIL_POOL_COLUMNS_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns
VITE_RETAIL_POOL_COLUMNS_SAVE_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns/save
VITE_GROUP_POOL_COLUMNS_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns
VITE_GROUP_POOL_COLUMNS_SAVE_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/pool-columns/save
VITE_RETAIL_COMPLETE_TASK_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/bpm/complete-task/retail
VITE_GROUP_COMPLETE_TASK_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/bpm/complete-task/group
VITE_CLAIM_TASK_API=${VITE_BASE_URL}${VITE_LANDING_SERVICE}/v1/bpm/user-tasks/claim

# Master reference data (shared after login, before inbox).
VITE_MASTER_SERVICE=/icic-master-data-service
VITE_MASTERS_API=${VITE_BASE_URL}${VITE_MASTER_SERVICE}/v1/masters

# Group DRS data and Financial fetch / save. Full URLs, same pattern as landing.
VITE_GROUP_DRS_SERVICE=/icic-drs-ui-service
VITE_GROUP_DRS_DATA_API=${VITE_BASE_URL}${VITE_GROUP_DRS_SERVICE}/api/v1/drs/ui/drs-data
VITE_GROUP_UW_DECISION_API=${VITE_BASE_URL}${VITE_GROUP_DRS_SERVICE}/api/v1/drs/uw-decision
VITE_GROUP_PARALLEL_DECISION_API=${VITE_BASE_URL}${VITE_GROUP_DRS_SERVICE}/api/v1/drs/parallel-decision
VITE_GROUP_DVT_VALIDATION_API=${VITE_BASE_URL}${VITE_GROUP_DRS_SERVICE}/api/v1/drs/validation/fetch
VITE_FINANCE_SERVICE=/icic-finance-service
VITE_GROUP_FINANCIAL_FETCH_API=${VITE_BASE_URL}${VITE_FINANCE_SERVICE}/v1/fetch
VITE_GROUP_FINANCIAL_SAVE_API=${VITE_BASE_URL}${VITE_FINANCE_SERVICE}/v1/save

# MMT grievance fetch / save (Group and Retail).
VITE_MMT_GRIEVANCE_SERVICE=/icic-retail-common-services
VITE_MMT_GRIEVANCE_FETCH_API=${VITE_BASE_URL}${VITE_MMT_GRIEVANCE_SERVICE}/v1/grievances/fetch
VITE_MMT_GRIEVANCE_SAVE_API=${VITE_BASE_URL}${VITE_MMT_GRIEVANCE_SERVICE}/v1/grievances/save

# NSDL PAN validation (plain JSON request and response, no payload encryption).
VITE_EXTERNAL_EVENT_SERVICE=/icic-external-event-service
VITE_NSDL_PAN_VALIDATE_API=${VITE_BASE_URL}${VITE_EXTERNAL_EVENT_SERVICE}/v1/nsdl/pan/validate
# BRE wrapper orchestrator (retrigger). Shared by Retail and Group DRS.
VITE_BRE_SERVICE=/icic-bre-wrapper-orchestrator
VITE_BRE_RETRIGGER_API=${VITE_BASE_URL}${VITE_BRE_SERVICE}/v1/events
