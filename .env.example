# One switch for Common, Retail, and Group. true reads each app's mock JSON.
# false sends that app to its own real API URL.
VITE_USE_MOCK=false

# Used by payload encryption for real business API calls. At least 32 characters.
VITE_CLIENT_ID=

# Common owns the login API.
# Login posts Base64 username and password to {VITE_AUTH_API_URL}/v1/auth/login
# Change password posts plaintext to {VITE_AUTH_API_URL}/v1/auth/change-password
# Forgot password posts to {VITE_AUTH_API_URL}/v1/auth/forgot-password
# Reset password posts to {VITE_AUTH_API_URL}/v1/auth/reset-password
VITE_AUTH_API_URL=http://172.30.74.182:8103/icic-iam-user-service
VITE_AUTH_BASIC_USERNAME=
VITE_AUTH_BASIC_PASSWORD=

# Retail and Group own their business APIs. The inbox path is appended by that app.
VITE_RETAIL_API_URL=
VITE_GROUP_API_URL=
