{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/routes/src/dev-config.json",
    "mock/**/*.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
