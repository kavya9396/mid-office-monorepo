# One switch for Common, Retail, and Group. true reads each app's mock JSON.
# false sends that app to its own real API URL.
VITE_USE_MOCK=true

# Used by payload encryption for real business API calls. At least 32 characters.
VITE_CLIENT_ID=

# Common owns the login API.
# Login posts Base64 username and password to {VITE_BASE_URL}/v1/auth/login
# with header X-Apigee-Authorization: Basic base64(VITE_AUTH_BASIC_USERNAME:VITE_AUTH_BASIC_PASSWORD)
# Change password posts plaintext to {VITE_BASE_URL}/v1/auth/change-password (Bearer token)
# Forgot password posts to {VITE_BASE_URL}/v1/auth/forgot-password
# Reset password posts to {VITE_BASE_URL}/v1/auth/reset-password
#
# Full API base URL used by the browser (same as Postman host + service path).
VITE_BASE_URL=https://midoffice-uat-api.icicilife.com/icic-iam-user-service
VITE_AUTH_BASIC_USERNAME=
VITE_AUTH_BASIC_PASSWORD=

# Retail and Group own their business APIs. The inbox path is appended by that app.
VITE_RETAIL_API_URL=
VITE_GROUP_API_URL=
