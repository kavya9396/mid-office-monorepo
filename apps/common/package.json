{
  "name": "@insurance-poc/common",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./src/services/loginService.ts",
      "import": "./src/services/loginService.ts",
      "default": "./src/services/loginService.ts"
    },
    "./detail-card": {
      "types": "./src/components/DetailCard.tsx",
      "import": "./src/components/DetailCard.tsx",
      "default": "./src/components/DetailCard.tsx"
    },
    "./quick-links": {
      "types": "./src/components/QuickLinks.tsx",
      "import": "./src/components/QuickLinks.tsx",
      "default": "./src/components/QuickLinks.tsx"
    },
    "./previous-policy": {
      "types": "./src/components/PreviousPolicy.tsx",
      "import": "./src/components/PreviousPolicy.tsx",
      "default": "./src/components/PreviousPolicy.tsx"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^6.0.0",
    "@insurance-poc/routes": "workspace:*",
    "@insurance-poc/ui": "workspace:*",
    "@insurance-poc/utils": "workspace:*",
    "@mui/material": "^6.4.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
